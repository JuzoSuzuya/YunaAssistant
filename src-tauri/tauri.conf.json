{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yuna-desktop",
  "version": "0.1.0",
  "identifier": "com.hoshikojima.yuna",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yuna",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "url": "http://127.0.0.1:8765",
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}