# Yuna by.Hoshi — локальный ассистент + единая память с сервером
# cp .env.example .env

# --- Сервер (единая память) ---
YUNA_SERVER_HOST=151.247.197.252
YUNA_SERVER_USER=root
YUNA_SERVER_HOSHI_PATH=/root/projects/Hoshi
# Пароль или SSH-ключ (ключ предпочтительнее: ssh-copy-id)
YUNA_SERVER_SSH_PASS=

# --- Владелец (тот же ID что на сервере) ---
HOSHI_OWNER_ID=1477417142

# --- Cursor Agent (локально) ---
CURSOR_AGENT_BIN=cursor-agent
# CURSOR_API_KEY=
# Модель для чата и голоса: auto (рекомендуется)
HOSHI_CURSOR_LIGHT_MODEL=auto

# --- Локальный API ---
YUNA_BRIDGE_HOST=127.0.0.1
YUNA_BRIDGE_PORT=8765
YUNA_VOICE_SOCKET=/tmp/yuna-voice.sock

# --- Синхронизация памяти (сек) ---
YUNA_MEMORY_SYNC_INTERVAL=8

# --- Голос ---
YUNA_DEFAULT_PERSONA=yuna
YUNA_VOICE_AUTOSPEAK=true
YUNA_VOICE_TTS_VOICE=ru-RU-DariyaNeural
YUNA_VOICE_TTS_RATE=+2%
YUNA_VOICE_TTS_PITCH=+14Hz
YUNA_VOICE_TTS_PITCH_SHIFT=1.06
# Мозги для голоса: cursor (рекомендуется) | ollama | auto (cursor → ollama)
YUNA_VOICE_LLM=cursor
# auto = модель Cursor Auto (без --model в CLI)
YUNA_CURSOR_VOICE_MODEL=auto

# --- Telegram (опционально, если локальный bridge шлёт в TG) ---
# HOSHI_BOT_TOKEN=

# --- Free local brain (рекомендуется) ---
YUNA_BRAIN=ollama
YUNA_VOICE_LLM=ollama
YUNA_OLLAMA_URL=http://127.0.0.1:11435
YUNA_OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
YUNA_OLLAMA_FAST_MODEL=llama3.1:8b-instruct-q4_K_M
YUNA_OLLAMA_VISION_MODEL=qwen2.5-vl:7b
