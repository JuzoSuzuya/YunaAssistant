# Скопируй в .env и заполни
HOSHI_BOT_TOKEN=your_bot_token_here
HOSHI_OWNER_ID=1477417142

# Для привязки личного Telegram-аккаунта (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Опционально: пароль 2FA аккаунта (для автопривязки)
TELEGRAM_2FA_PASSWORD=

# Быстрая модель для диалогов (composer-2.5-fast), режим ask без tools
# HOSHI_CURSOR_LIGHT_MODEL=composer-2.5-fast
# HOSHI_CURSOR_LIGHT_MODE=ask
# HOSHI_EXTERNAL_CONTEXT_LIGHT=20
# API-ключ Cursor (fallback если сессия agent login слетела)
# CURSOR_API_KEY=
