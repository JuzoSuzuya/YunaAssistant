{
  "name": "yuna-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Юна — настольная панель (Vue 3 + Vite SPA, served by local_bridge at /)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "rm -rf ./assets ./index.html",
    "build": "vite build",
    "postbuild": "cp -r ./assets/. ../../assets/ && ls -la ./index.html ./assets/"
  },
  "dependencies": {
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
